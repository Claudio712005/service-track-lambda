FROM eclipse-temurin:21-jdk-jammy AS build

WORKDIR /workspace

COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle ./gradle
RUN chmod +x gradlew

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon dependencies > /dev/null 2>&1 || true

COPY src ./src

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon clean build -x test -PexecucaoLocal=true


FROM eclipse-temurin:21-jre-alpine AS runtime

ARG DD_TRACE_VERSION=1.65.1

ENV DD_TRACE_ENABLED=false

WORKDIR /deployments

RUN addgroup -S servicetrack && adduser -S servicetrack -G servicetrack

ADD --chown=servicetrack:servicetrack --chmod=644 \
    https://repo1.maven.org/maven2/com/datadoghq/dd-java-agent/${DD_TRACE_VERSION}/dd-java-agent-${DD_TRACE_VERSION}.jar \
    /deployments/dd-java-agent.jar

COPY --from=build --chown=servicetrack:servicetrack /workspace/build/quarkus-app/lib/     ./lib/
COPY --from=build --chown=servicetrack:servicetrack /workspace/build/quarkus-app/*.jar    ./
COPY --from=build --chown=servicetrack:servicetrack /workspace/build/quarkus-app/app/     ./app/
COPY --from=build --chown=servicetrack:servicetrack /workspace/build/quarkus-app/quarkus/ ./quarkus/

USER servicetrack

EXPOSE 8080

ENTRYPOINT ["java", "-javaagent:/deployments/dd-java-agent.jar", "-Dquarkus.http.host=0.0.0.0", "-jar", "/deployments/quarkus-run.jar"]
